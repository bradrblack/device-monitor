{
  "__inputs": [
    {
      "name": "DS_INFLUX",
      "label": "InfluxDB (Flux)",
      "type": "datasource",
      "pluginId": "influxdb",
      "pluginName": "InfluxDB"
    }
  ],
  "title": "Device Monitor",
  "uid": "appliance-monitor",
  "schemaVersion": 39,
  "version": 2,
  "tags": [
    "appliances"
  ],
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "bucket",
        "label": "Bucket",
        "type": "textbox",
        "query": "CHANGE_ME",
        "current": {
          "text": "CHANGE_ME",
          "value": "CHANGE_ME"
        },
        "options": [
          {
            "selected": true,
            "text": "CHANGE_ME",
            "value": "CHANGE_ME"
          }
        ]
      },
      {
        "name": "device",
        "label": "Device",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "${DS_INFLUX}"
        },
        "multi": true,
        "includeAll": true,
        "refresh": 2,
        "sort": 1,
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"${bucket}\", tag: \"device\")",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "state-timeline",
      "title": "On / off timeline",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUX}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUX}"
          },
          "query": "prior = from(bucket: \"${bucket}\")\n  |> range(start: -90d, stop: v.timeRangeStart)\n  |> filter(fn: (r) => r._measurement == \"appliance_state\" and r._field == \"running\" and contains(value: r.device, set: ${device:json}))\n  |> group(columns: [\"device\"])\n  |> last()\n  |> map(fn: (r) => ({r with _time: v.timeRangeStart}))\ndata = from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"appliance_state\" and r._field == \"running\" and contains(value: r.device, set: ${device:json}))\nunion(tables: [prior, data])\n  |> group()\n  |> keep(columns: [\"_time\", \"_value\", \"device\"])\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"device\"], valueColumn: \"_value\")\n  |> sort(columns: [\"_time\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "ON",
                  "color": "green",
                  "index": 0
                },
                "0": {
                  "text": "OFF",
                  "color": "#6e6e6e",
                  "index": 1
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#6e6e6e",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0,
            "spanNulls": true,
            "insertNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "auto",
        "alignValue": "center",
        "rowHeight": 0.8,
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Current state",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 4
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUX}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUX}"
          },
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: -90d)\n  |> filter(fn: (r) => r._measurement == \"appliance_state\" and r._field == \"running\" and contains(value: r.device, set: ${device:json}))\n  |> group(columns: [\"device\"])\n  |> last()\n  |> keep(columns: [\"_time\", \"_value\", \"device\"])\n  |> rename(columns: {_value: \"state\"})\n  |> group()"
        }
      ],
      "transformations": [
        {
          "id": "partitionByValues",
          "options": {
            "fields": [
              "device"
            ],
            "keepFields": false
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "ON",
                  "color": "green",
                  "index": 0
                },
                "0": {
                  "text": "OFF",
                  "color": "#6e6e6e",
                  "index": 1
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#6e6e6e",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^state/",
          "values": false
        },
        "colorMode": "background",
        "textMode": "value_and_name",
        "orientation": "horizontal"
      }
    },
    {
      "id": 3,
      "type": "barchart",
      "title": "Run time per day (hours)",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUX}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUX}"
          },
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"appliance_state\" and r._field == \"seconds\" and contains(value: r.device, set: ${device:json}))\n  |> map(fn: (r) => ({r with _value: r._value / 3600.0}))\n  |> aggregateWindow(every: 1d, fn: sum, createEmpty: true, timeSrc: \"_start\")\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"device\"], valueColumn: \"_value\")"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "xTickLabelRotation": 0,
        "legend": {
          "showLegend": true
        },
        "stacking": "none"
      }
    },
    {
      "id": 4,
      "type": "table",
      "title": "Recent runs (at stop)",
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUX}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUX}"
          },
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"appliance_state\" and r._field == \"seconds\" and contains(value: r.device, set: ${device:json}))\n  |> map(fn: (r) => ({r with minutes: r._value / 60.0}))\n  |> keep(columns: [\"_time\", \"device\", \"minutes\"])\n  |> group()\n  |> sort(columns: [\"_time\"], desc: true)\n  |> limit(n: 100)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "m",
          "decimals": 1
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Time"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Stopped at"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 5,
      "type": "barchart",
      "title": "Runs per day",
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUX}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUX}"
          },
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"appliance_state\" and r._field == \"seconds\" and contains(value: r.device, set: ${device:json}))\n  |> aggregateWindow(every: 1d, fn: count, createEmpty: true, timeSrc: \"_start\")\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"device\"], valueColumn: \"_value\")"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "xTickLabelRotation": 0,
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Time since last data",
      "description": "From the 10-minute readings. Over 30 minutes means the board is offline (power, Wi-Fi) or InfluxDB isn't receiving.",
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUX}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUX}"
          },
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: -30d)\n  |> filter(fn: (r) => r._measurement =~ /^appliance_/ and contains(value: r.device, set: ${device:json}))\n  |> group(columns: [\"device\"])\n  |> last()\n  |> map(fn: (r) => ({device: r.device, _time: r._time, _value: float(v: uint(v: now()) - uint(v: r._time)) / 1000000000.0}))\n  |> group()\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"device\"], valueColumn: \"_value\")\n  |> drop(columns: [\"_time\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1200
              },
              {
                "color": "red",
                "value": 1800
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Vibration: idle and running, against the thresholds",
      "description": "Every 10 minutes: the loudest idle window and the quietest running window, with the thresholds in force. Both thresholds should sit above 'idle peak' and below 'running lowest'.",
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUX}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUX}"
          },
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"appliance_reading\" and (r._field == \"rms_idle_max\" or r._field == \"rms_run_min\" or r._field == \"rms_on\" or r._field == \"rms_off\") and contains(value: r.device, set: ${device:json}))\n  |> map(fn: (r) => ({_time: r._time, _value: r._value, series: r.device + \" \" + (if r._field == \"rms_idle_max\" then \"idle peak\" else if r._field == \"rms_run_min\" then \"running lowest\" else if r._field == \"rms_on\" then \"start threshold\" else \"stop threshold\")}))\n  |> group(columns: [\"series\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "m/s²",
          "decimals": 3,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "pointSize": 4,
            "showPoints": "always",
            "spanNulls": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*threshold.*"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    6,
                    4
                  ]
                }
              },
              {
                "id": "custom.showPoints",
                "value": "never"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Board health: Wi-Fi signal",
      "gridPos": {
        "x": 0,
        "y": 41,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUX}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUX}"
          },
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"appliance_reading\" and r._field == \"rssi\" and contains(value: r.device, set: ${device:json}))\n  |> keep(columns: [\"_time\", \"_value\", \"device\"])\n  |> group(columns: [\"device\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dBm",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 9,
      "type": "table",
      "title": "Reboots",
      "gridPos": {
        "x": 12,
        "y": 41,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUX}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUX}"
          },
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"appliance_boot\" and contains(value: r.device, set: ${device:json}))\n  |> pivot(rowKey: [\"_time\", \"device\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> keep(columns: [\"_time\", \"device\", \"reason\", \"version\", \"sensor\"])\n  |> group()\n  |> sort(columns: [\"_time\"], desc: true)"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "influxdb",
          "uid": "${DS_INFLUX}"
        },
        "enable": true,
        "iconColor": "orange",
        "name": "Reboots",
        "target": {
          "refId": "Anno",
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"appliance_boot\" and r._field == \"reason\" and contains(value: r.device, set: ${device:json}))\n  |> group()\n  |> map(fn: (r) => ({_time: r._time, text: r.device + \" rebooted: \" + r._value}))"
        }
      },
      {
        "datasource": {
          "type": "influxdb",
          "uid": "${DS_INFLUX}"
        },
        "enable": true,
        "iconColor": "purple",
        "name": "Threshold changes",
        "target": {
          "refId": "Anno",
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"appliance_config\" and r._field == \"rms_on\" and contains(value: r.device, set: ${device:json}))\n  |> group()\n  |> map(fn: (r) => ({_time: r._time, text: r.device + \" thresholds changed (start \" + string(v: r._value) + \")\"}))"
        }
      }
    ]
  }
}
