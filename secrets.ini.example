; Copy to secrets.ini (git-ignored) and set a password for OTA uploads.
; Letters and digits only: it's passed to the compiler and to espota as-is.
; It is also each new board's first admin password for the web page.
[secrets]
ota_password = change-me
; Default board for `pio run -e devmon-ota -t upload` (override with --upload-port).
ota_host = devmon.local
