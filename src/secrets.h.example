#pragma once

// OPTIONAL. Copy this file to secrets.h (git-ignored) only if you want new
// boards to start with these values. Without it, a new board opens its Wi-Fi
// setup portal on first boot and everything else is set on its web page.
// (The OTA password is in secrets.ini, see secrets.ini.example.)
//
// Everything here is only a STARTING value: a value saved on the board (setup
// portal or web page) takes priority. Any line can be left out.

// Wi-Fi to try on a board that has no saved network yet.
// #define WIFI_SSID   "your-wifi-ssid"
// #define WIFI_PASS   "your-wifi-password"

// Device name, used as <name>.local, in notifications, as the InfluxDB device
// tag and as the Home Assistant device. Lowercase letters, digits and "-".
// Leave it out and each board names itself devmon-XXXX (from its MAC).
// #define DEVICE_NAME "sump"

// InfluxDB 2.x write URL (with a token), or a Telegraf http_listener_v2 URL
// (no token). Leave it out to disable.
// #define INFLUX_URL   "http://your-server:8086/api/v2/write?org=home&bucket=devmon&precision=ns"
// #define INFLUX_TOKEN "write-only-token"
// #define INFLUX_URL   "http://your-server:8186/devmon"

// ntfy topic for start/stop, daily report, sensor and reboot pushes. Pick
// something random and unguessable (ntfy topics are unauthenticated).
// #define NTFY_SERVER "https://ntfy.sh"
// #define NTFY_TOPIC  "your-random-ntfy-topic"

// MQTT broker for Home Assistant (MQTT Discovery). Leave MQTT_HOST out to disable.
// #define MQTT_HOST "192.168.1.10"
// #define MQTT_PORT 1883
// #define MQTT_USER "mqtt-user"
// #define MQTT_PASS "mqtt-password"
